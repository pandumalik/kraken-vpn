# ==============================================================================
# Kraken VPN .gitignore
# ==============================================================================

# Rust build artifacts & debug symbols
/target/
**/target/
Cargo.lock.lock
**/*.rs.bk
*.pdb
release-artifacts/
installer/*.ico

# Legacy Electron dependencies & build outputs
legacy-electron/node_modules/
legacy-electron/dist/
node_modules/
jspm_packages/
dist/
out/
build/

# Environment secrets and local credentials
.env
.env.*
!.env.example
!.env.*.example

# Personal VPN configs, private keys & certificates
*.ovpn
# Keep sample.ovpn tracked for testing purposes
!sample.ovpn
*.key
*.pem
*.crt
*.csr
*.p12
*.pfx
*.jks
*.keystore

# Debug and system logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Operating system files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# IDE and editor configurations
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Local scratch notes
note.txt
