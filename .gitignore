# ==============================================================================
# Kraken VPN (Rust) .gitignore
# ==============================================================================

# Rust / Cargo build artifacts & debug/profiling outputs
/target/
**/target/
**/*.rs.bk
*.pdb
*.profraw
*.profdata
Cargo.lock.lock

# Windows installer & release packaging outputs
/release-artifacts/
/release-meta/
/installer/*.ico
/installer/Output/
*.exe
*.msi
SHA256SUMS.txt

# Personal VPN configs, private keys & certificates
*.ovpn
# Keep sample.ovpn tracked for tests & documentation
!sample.ovpn
*.key
*.pem
*.crt
*.csr
*.p12
*.pfx
*.jks
*.keystore

# Environment secrets and local credentials
.env
.env.*
!.env.example
!.env.*.example

# Debug, CI, and runtime logs
*.log
logs/
runtime/

# Operating system files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# IDE and editor configurations
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Local scratch notes
note.txt
